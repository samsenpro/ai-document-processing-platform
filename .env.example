# Copia este archivo a .env y rellena los valores antes de ejecutar `docker compose up -d`.
# Nunca subas el archivo .env al repositorio.

# ---- PostgreSQL ----
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Seguridad ----
# Secreto HMAC para firmar los JWT (mínimo 32 bytes). Genera uno con: openssl rand -base64 48
JWT_SECRET=

# ---- Servicio de IA (Python) ----
AI_SERVICE_URL=http://python-ai:8000
# Clave interna compartida entre Java y Python (mínimo 32 caracteres). Genera una con: openssl rand -hex 32
AI_SERVICE_API_KEY=

# ---- LLM (opcional) ----
# Cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter, Ollama...). Si LLM_BASE_URL queda
# vacío el servicio de IA usa solo sus algoritmos locales (reglas, regex y resumen extractivo).
# Ejemplo con Ollama local (perfil "ollama" de docker compose): LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Observabilidad ----
# Contraseña del usuario admin de Grafana (http://localhost:3006)
GRAFANA_ADMIN_PASSWORD=

# ---- Almacenamiento de archivos ----
FILE_STORAGE_PATH=/storage/documents
